#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DGUFO_RELEASE_VERSION=$(shell cat version.txt) \
		-DGUFO_REVISION=$(shell git describe --always --dirty 2>/dev/null || echo unknown)

override_dh_auto_build:
	dh_auto_build --parallel

override_dh_auto_install:
	dh_auto_install --destdir=debian/gufo

# The project's test suite is not part of the package build; hosted CI
# covers it separately.
override_dh_auto_test:

# debian/changelog is the authority for the package version, but Release Please
# only regenerates it when a release runs (.github/workflows/release-please.yml).
# Building any other commit would therefore name the package after the previous
# release while the binary reports version.txt. Regenerate the top entry from
# version.txt at build time; the script is idempotent, so a rebuild of the same
# version keeps the same Debian revision.
#
# Position: before dh_gencontrol, the first sequencer step that reads
# debian/changelog for the package version, so the control metadata and the
# .deb file name agree. It is deliberately after dh_auto_configure, which
# stamps GUFO_REVISION from `git describe --dirty`: regenerating the changelog
# dirties the source tree, and doing that first would put a spurious -dirty on
# every binary. Two known leftovers of the earlier parse dpkg-buildpackage does
# of its own: the "source version" line in its log, and the file names of
# .changes/.buildinfo, keep the previous release until the next build.
# Skip it with DEB_BUILD_OPTIONS=no-changelog-regen.
execute_before_dh_gencontrol:
ifneq (,$(filter no-changelog-regen,$(DEB_BUILD_OPTIONS)))
	@echo "dh_gencontrol: skipping changelog regeneration (DEB_BUILD_OPTIONS=no-changelog-regen)"
else
	debian/gen-changelog.sh
endif

# dwz cannot process the DWARF5 debug sections emitted by the ROCm clang
# toolchain; skip the debug-info deduplication step.
override_dh_dwz:

# The AMD ROCm packages do not ship shlibs metadata; their runtime
# dependencies are declared explicitly in debian/control.
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info

# The service needs a model configured in /etc/gufo/gufo.env before it
# can run; do not enable or start it on install, otherwise it enters a
# restart loop until configured. Start it explicitly after configuring:
#   sudo systemctl enable --now gufo
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start